{
  "name": "assetnest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AssetNest — self-hostable, web-only, multi-workspace asset management. Core operation never requires AI or public cloud services.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:generate": "turbo build --filter=@assetnest/api && node scripts/generate-sdk.mjs",
    "sdk:check": "turbo build --filter=@assetnest/api && node scripts/generate-sdk.mjs --check",
    "db:generate": "pnpm --filter @assetnest/db generate",
    "db:migrate": "pnpm --filter @assetnest/db migrate",
    "db:seed": "pnpm --filter @assetnest/db seed",
    "db:backup": "sh infrastructure/scripts/backup.sh",
    "db:restore": "sh infrastructure/scripts/restore.sh",
    "ops:backup-drill": "sh infrastructure/scripts/drill-restore.sh",
    "ops:load-test": "node scripts/load-test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:sync": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
