{
  "name": "@assetnest/api",
  "version": "0.1.0",
  "private": true,
  "description": "AssetNest HTTP API (NestJS, CommonJS). See README.md for required environment variables.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@assetnest/ai": "workspace:*",
    "@assetnest/config": "workspace:*",
    "@assetnest/contracts": "workspace:*",
    "@assetnest/db": "workspace:*",
    "@assetnest/domain": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/mcp": "0.0.4",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.18",
    "multer": "2.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.4",
    "@types/multer": "1.4.12",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "rimraf": "6.1.4",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "type": "module",
  "exports": {
    ".": "./dist/main.js"
  }
}
