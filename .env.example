# AssetNest — example environment (names only; never commit real secrets)
# Copy to .env and replace every REPLACE_*/CHANGE_ME value before booting.

NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173
API_PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://assetnest:CHANGE_ME@localhost:5432/assetnest
# Max connections in the pg pool (set 1 when using embedded/socket Postgres)
DATABASE_POOL_MAX=10

# Optional Redis + BullMQ worker (leave unset to disable async jobs in dev)
REDIS_URL=redis://localhost:6379

# REQUIRED: generate with `openssl rand -base64 48` (32+ random bytes)
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
# REQUIRED: 32-byte key, base64 encoded (used to encrypt stored integration/AI secrets)
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_ENCODED_KEY
# Session hardening (0 disables the respective cap)
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Compose-only (used by infrastructure/compose/compose.yaml):
# POSTGRES_USER=assetnest
# POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE
# POSTGRES_DB=assetnest
# Optional: POSTGRES_PORT=5432, REDIS_PORT=6379, WEB_PORT=80

# Storage: local (default) | s3
STORAGE_DRIVER=local
STORAGE_ROOT=./var/private-files

# Mail: log (dev) | smtp (configure SMTP_* for real delivery)
MAIL_TRANSPORT=log

# Optional features (core works with all of these disabled)
AI_ENABLED=false
# Exact origins allowed for private AI endpoints (example: http://ollama:11434).
AI_PRIVATE_ORIGINS=
MCP_ENABLED=false
WEBHOOKS_ENABLED=false
# DANGER: allow webhooks to private/loopback destinations. Never in multi-tenant deployments.
# WEBHOOKS_ALLOW_PRIVATE=false

# Enterprise SSO (optional, provider-neutral OIDC; core login still works without it)
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com/realms/assetnest
# OIDC_CLIENT_ID=assetnest
# OIDC_CLIENT_SECRET=CHANGE_ME
# Defaults to ${PUBLIC_APP_URL}/api/v1/auth/oidc/callback
# OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_CREATE=false
# Comma-separated email domains allowed to sign in (empty = any)
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_CLIENT_AUTH_METHOD=client_secret_post

# Bootstrap admin (used by `pnpm db:seed` on empty databases only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
