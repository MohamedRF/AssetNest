{
  "name": "AssetNest — Daily Asset Health Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "days", "triggerAtHour": 7, "triggerAtMinute": 0 }]
        }
      },
      "id": "b0000001-0000-4000-8000-000000000001",
      "name": "Every morning 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ASSETNEST_URL }}/api/v1/workspaces/{{ $env.ASSETNEST_WORKSPACE_ID }}/assets?status=lost&pageSize=50",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b0000002-0000-4000-8000-000000000002",
      "name": "Lost assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, -80]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ASSETNEST_URL }}/api/v1/workspaces/{{ $env.ASSETNEST_WORKSPACE_ID }}/warranties?expiringDays=30",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b0000003-0000-4000-8000-000000000003",
      "name": "Warranties expiring ≤30d",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 80]
    },
    {
      "parameters": {
        "jsCode": "const lost = $items('Lost assets')[0]?.json?.items ?? [];\nconst warranties = $items('Warranties expiring ≤30d')[0]?.json ?? [];\nconst expiring = Array.isArray(warranties) ? warranties : (warranties.items ?? []);\nconst lines = [];\nlines.push(`AssetNest digest — ${new Date().toISOString().slice(0, 10)}`);\nlines.push(`Lost assets: ${lost.length}`);\nfor (const a of lost.slice(0, 10)) lines.push(` - ${a.assetTag}: ${a.displayName} (${a.status})`);\nlines.push(`Warranties expiring within 30 days: ${expiring.length}`);\nfor (const w of expiring.slice(0, 10)) lines.push(` - asset ${w.assetId}: ${w.provider} expires ${w.expiresOn} (${w.derivedStatus ?? 'unknown'})`);\nreturn [{ json: { digest: lines.join('\\n'), lostCount: lost.length, expiringCount: expiring.length } }];"
      },
      "id": "b0000004-0000-4000-8000-000000000004",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.example.invalid/replace-with-slack-or-mail",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.digest }) }}",
        "options": {}
      },
      "id": "b0000005-0000-4000-8000-000000000005",
      "name": "Notify (replace URL, then enable)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "disabled": true
    },
    {
      "parameters": {
        "content": "Setup:\n1. Env vars: ASSETNEST_URL (e.g. https://assets.example.com), ASSETNEST_WORKSPACE_ID.\n2. n8n credential httpHeaderAuth: Name = Authorization, Value = Bearer anst_... (token from the AssetNest Integrations UI with scopes assets:read + reports:read).\n3. Activate; check the first execution. Replace the Notify node URL (Slack incoming webhook, Discord, email API...) and enable it."
      },
      "id": "b0000006-0000-4000-8000-000000000006",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, 240]
    }
  ],
  "connections": {
    "Every morning 07:00": {
      "main": [[{ "node": "Lost assets", "type": "main", "index": 0 }]]
    },
    "Lost assets": {
      "main": [[{ "node": "Warranties expiring ≤30d", "type": "main", "index": 0 }]]
    },
    "Warranties expiring ≤30d": {
      "main": [[{ "node": "Build digest", "type": "main", "index": 0 }]]
    },
    "Build digest": {
      "main": [[{ "node": "Notify (replace URL, then enable)", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
