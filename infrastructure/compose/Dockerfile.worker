# syntax=docker/dockerfile:1
#
# AssetNest worker image: drains the transactional outbox (BullMQ) and delivers
# notifications. The API writes outbox rows; this process claims and publishes
# them. Uses the SAME workspace and build pipeline as the API.
#
# Build context MUST be the repository root:
#   docker build -f infrastructure/compose/Dockerfile.worker -t assetnest/worker:local .

FROM node:24-alpine

RUN corepack enable \
 && npm install --global pnpm@10.34.9 \
 && npm cache clean --force

WORKDIR /app

# Same whole-workspace manifest set as the API image (frozen lockfile validation).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/ ./apps/worker/

RUN pnpm install --frozen-lockfile --filter @assetnest/worker... \
 && pnpm --filter @assetnest/db build \
 && pnpm --filter @assetnest/worker build

USER node

# Exits 0 with a clear notice when REDIS_URL is unset; otherwise runs the relay.
CMD ["node", "apps/worker/dist/main.js"]
