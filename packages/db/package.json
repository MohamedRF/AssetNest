{
  "name": "@assetnest/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "node ./dist/migrate.js",
    "seed": "node ./dist/seed.js",
    "clean": "rimraf dist coverage",
    "dev:pglite": "node scripts/dev-pglite.mjs"
  },
  "dependencies": {
    "@assetnest/domain": "workspace:*",
    "@electric-sql/pglite": "0.5.17",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "rimraf": "6.1.4",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
